---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { 
  title = 'Schossacher Garage | Schweizer Werkstatt & Autohandel',
  description = 'Schossacher Garage: Ihre erstklassige Schweizer Autowerkstatt für MFK-Vorbereitung, KFZ-Reparaturen & Diagnostik sowie vertrauensvoller Autohändler für An- & Verkauf von Occasionen.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Schossacher Garage, Autowerkstatt Schweiz, MFK Vorbereitung, KFZ Reparatur, Occasionen An- und Verkauf, Autohandel, Auto kaufen Aarau" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/hero.jpg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Astro View Transitions Router -->
    <ClientRouter fallback="animate" />
  </head>
  <body class="bg-[#FFFDF5] text-stone-900 antialiased selection:bg-[#D4AF37] selection:text-black">
    <slot />
  </body>
</html>
