---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import Showroom from '../components/Showroom.jsx';
import FinanceCalculator from '../components/FinanceCalculator.jsx';
import Footer from '../components/Footer.jsx';
import Preloader from '../components/Preloader.jsx';
import { Car } from 'lucide-react';
---

<Layout title="Autohandel & Occasionen | Schossacher Garage Schweiz">
  <Preloader client:load />
  <Navbar client:load />

  <main class="pt-28 pb-16">
    <section class="py-16 relative bg-[#FEF9E7] border-b border-[#D4AF37]/20">
      <div class="container text-center max-w-3xl space-y-4">
        <div class="gold-badge mx-auto">
          <Car className="w-4 h-4 text-[#785E07]" />
          <span>Geprüfte Qualität</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-stone-900 tracking-tight font-serif">
          Autohandel & <span class="text-gold-gradient">Occasionen</span>
        </h1>
        <p class="text-stone-700 text-base md:text-lg font-semibold">
          Entdecken Sie unser aktuelles Angebot an qualitätsgeprüften Gebrauchtwagen, Sportwagen und Luxuslimousinen mit Schweizer Garantie.
        </p>
      </div>
    </section>

    <Showroom client:load />
    <FinanceCalculator client:visible />
  </main>

  <Footer client:visible />
</Layout>
