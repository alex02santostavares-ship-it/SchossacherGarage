---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import ContactSection from '../components/ContactSection.jsx';
import Footer from '../components/Footer.jsx';
import Preloader from '../components/Preloader.jsx';
import { MapPin, Phone, Mail, Clock } from 'lucide-react';
---

<Layout title="Kontakt & Anfahrt | Schossacher Garage Schweiz">
  <Preloader client:load />
  <Navbar client:load />

  <main className="pt-28 pb-16">
    <section className="py-16 relative bg-gradient-to-b from-[#07090e] via-[#0e1420] to-[#07090e] border-b border-white/5">
      <div className="container text-center max-w-3xl space-y-4">
        <div className="badge-cyber mx-auto">
          <MapPin className="w-4 h-4 text-cyan-400" />
          <span>Aarau, Schweiz</span>
        </div>
        <h1 className="text-4xl md:text-6xl font-bold text-white tracking-tight font-serif">
          Kontakt & <span className="text-cyan-gradient">Anfahrt</span>
        </h1>
        <p className="text-slate-300 text-base md:text-lg">
          Vereinbaren Sie Ihren Termin online oder rufen Sie uns direkt an. Wir freuen uns auf Ihren Besuch.
        </p>
      </div>
    </section>

    <ContactSection client:load />
  </main>

  <Footer client:visible />
</Layout>
