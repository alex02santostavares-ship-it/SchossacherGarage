---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import ContactSection from '../components/ContactSection.jsx';
import Footer from '../components/Footer.jsx';
import { MapPin } from 'lucide-react';
---

<Layout title="Kontakt & Anfahrt | Schossacher Garage Schweiz">
  <Navbar client:load />

  <main class="pt-28 pb-16 bg-transparent">
    <section class="py-16 relative bg-transparent border-b border-[#D4AF37]/15">
      <div class="container text-center max-w-3xl space-y-4">
        <div class="gold-badge mx-auto">
          <MapPin className="w-4 h-4 text-[#FFD700]" />
          <span>Dübendorf, Kanton Zürich</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-white tracking-tight font-serif">
          Kontakt & <span class="text-gold-gradient">Anfahrt</span>
        </h1>
        <p class="text-stone-300 text-base md:text-lg font-semibold">
          Vereinbaren Sie Ihren Termin online oder rufen Sie uns direkt an unter 044 820 74 74. Wir freuen uns auf Ihren Besuch im Schossacher 22.
        </p>
      </div>
    </section>

    <ContactSection client:load />
  </main>

  <Footer client:visible />
</Layout>
