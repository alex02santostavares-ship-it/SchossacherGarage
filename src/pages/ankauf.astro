---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import AnkaufCalculator from '../components/AnkaufCalculator.jsx';
import Footer from '../components/Footer.jsx';
import Preloader from '../components/Preloader.jsx';
import { DollarSign, Shield, RefreshCw } from 'lucide-react';
---

<Layout title="Auto-Ankauf & Inzahlungnahme | Schossacher Garage Schweiz">
  <Preloader client:load />
  <Navbar client:load />

  <main className="pt-28 pb-16">
    <section className="py-16 relative bg-gradient-to-b from-[#07090e] via-[#0e1420] to-[#07090e] border-b border-white/5">
      <div className="container text-center max-w-3xl space-y-4">
        <div className="badge-amber mx-auto">
          <DollarSign className="w-4 h-4 text-[#F59E0B]" />
          <span>Faire Schweizer Marktpreise</span>
        </div>
        <h1 className="text-4xl md:text-6xl font-bold text-white tracking-tight font-serif">
          Auto-Ankauf & <span className="text-amber-gradient">Eintausch</span>
        </h1>
        <p className="text-slate-300 text-base md:text-lg">
          Verkaufen Sie Ihr Fahrzeug schnell, sicher und unkompliziert. Sofortige Auszahlung oder faire Anrechnung beim Kauf einer Occasion.
        </p>
      </div>
    </section>

    <AnkaufCalculator client:load />
  </main>

  <Footer client:visible />
</Layout>
