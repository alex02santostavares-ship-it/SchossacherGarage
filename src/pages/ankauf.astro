---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import AnkaufCalculator from '../components/AnkaufCalculator.jsx';
import Footer from '../components/Footer.jsx';
import Preloader from '../components/Preloader.jsx';
import { DollarSign } from 'lucide-react';
---

<Layout title="Auto-Ankauf & Inzahlungnahme | Schossacher Garage Schweiz">
  <Preloader client:load />
  <Navbar client:load />

  <main class="pt-28 pb-16 bg-transparent">
    <section class="py-16 relative bg-transparent border-b border-[#D4AF37]/15">
      <div class="container text-center max-w-3xl space-y-4">
        <div class="gold-badge mx-auto">
          <DollarSign className="w-4 h-4 text-[#FFD700]" />
          <span>Faire Schweizer Marktpreise</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-white tracking-tight font-serif">
          Auto-Ankauf & <span class="text-gold-gradient">Eintausch</span>
        </h1>
        <p class="text-stone-300 text-base md:text-lg font-semibold">
          Verkaufen Sie Ihr Fahrzeug schnell, sicher und unkompliziert in Dübendorf. Sofortige Auszahlung oder faire Anrechnung beim Kauf einer Occasion.
        </p>
      </div>
    </section>

    <AnkaufCalculator client:load />
  </main>

  <Footer client:visible />
</Layout>
