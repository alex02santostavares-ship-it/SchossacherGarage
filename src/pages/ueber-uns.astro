---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import WhyUs from '../components/WhyUs.jsx';
import Testimonials from '../components/Testimonials.jsx';
import Footer from '../components/Footer.jsx';
import Preloader from '../components/Preloader.jsx';
import { Award, ShieldCheck, Wrench, Users, HeartHandshake } from 'lucide-react';
---

<Layout title="Über Uns | Schossacher Garage Schweiz">
  <Preloader client:load />
  <Navbar client:load />

  <main className="pt-28 pb-16">
    <section className="py-16 relative bg-gradient-to-b from-[#07090e] via-[#0e1420] to-[#07090e] border-b border-white/5">
      <div className="container text-center max-w-3xl space-y-4">
        <div className="badge-cyber mx-auto">
          <Award className="w-4 h-4 text-cyan-400" />
          <span>Tradition & Zukunft</span>
        </div>
        <h1 className="text-4xl md:text-6xl font-bold text-white tracking-tight font-serif">
          Über die <span className="text-cyan-gradient">Schossacher Garage</span>
        </h1>
        <p className="text-slate-300 text-base md:text-lg">
          Seit über 15 Jahren stehen wir in Aarau & der ganzen Schweiz für leidenschaftliches Handwerk, ehrliche Beratung und modernste Fahrzeugtechnik.
        </p>
      </div>
    </section>

    {/* Story Section */}
    <section className="py-20 bg-[#07090e] relative">
      <div className="container">
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div className="lg:col-span-6 relative">
            <div className="rounded-2xl overflow-hidden border border-cyan-500/30 shadow-2xl">
              <img src="/images/workshop.jpg" alt="Schossacher Werkstatt Team" className="w-full h-[400px] object-cover" />
            </div>
          </div>

          <div className="lg:col-span-6 space-y-6">
            <h2 className="text-3xl font-bold text-white font-serif">Unsere Werkstatt-Philosophie</h2>
            <p className="text-slate-300 text-sm md:text-base leading-relaxed">
              Bei uns ist Ihr Auto keine Nummer. Wir verbinden traditionelles Schweizer KFZ-Handwerk mit modernster elektronischer Diagnostik. Ob MFK-Vorführung, Fahrwerksservice oder An- & Verkauf – wir garantieren transparente Preise und höchste Präzision.
            </p>
            <div className="grid grid-cols-2 gap-4 pt-2">
              <div className="bg-white/5 p-4 rounded-xl border border-white/10">
                <span className="text-2xl font-bold text-cyan-400 font-mono">15+</span>
                <span className="block text-xs text-slate-300">Jahre Erfahrung</span>
              </div>
              <div className="bg-white/5 p-4 rounded-xl border border-white/10">
                <span className="text-2xl font-bold text-[#F59E0B] font-mono">500+</span>
                <span className="block text-xs text-slate-300">Verkaufte Occasionen</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <WhyUs client:visible />
    <Testimonials client:visible />
  </main>

  <Footer client:visible />
</Layout>
