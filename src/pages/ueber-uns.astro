---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import WhyUs from '../components/WhyUs.jsx';
import Testimonials from '../components/Testimonials.jsx';
import Footer from '../components/Footer.jsx';
import Preloader from '../components/Preloader.jsx';
import { Award } from 'lucide-react';
---

<Layout title="Über Uns | Schossacher Garage Schweiz">
  <Preloader client:load />
  <Navbar client:load />

  <main class="pt-28 pb-16 bg-transparent">
    <section class="py-16 relative bg-transparent border-b border-[#D4AF37]/15">
      <div class="container text-center max-w-3xl space-y-4">
        <div class="gold-badge mx-auto">
          <Award className="w-4 h-4 text-[#FFD700]" />
          <span>Tradition & Zukunft</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-white tracking-tight font-serif">
          Über die <span class="text-gold-gradient">Schossacher Garage</span>
        </h1>
        <p class="text-stone-300 text-base md:text-lg font-semibold">
          Seit über 15 Jahren stehen wir in Dübendorf & der ganzen Schweiz für leidenschaftliches Handwerk, ehrliche Beratung und modernste Fahrzeugtechnik.
        </p>
      </div>
    </section>

    {/* Story Section */}
    <section class="py-20 bg-transparent relative">
      <div class="container">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          <div class="lg:col-span-6 relative">
            <div class="rounded-2xl overflow-hidden border border-[#D4AF37]/30 shadow-2xl">
              <img src="/images/workshop.jpg" alt="Schossacher Werkstatt Team" class="w-full h-[400px] object-cover" />
            </div>
          </div>

          <div class="lg:col-span-6 space-y-6">
            <h2 class="text-3xl font-bold text-white font-serif">Unsere Werkstatt-Philosophie</h2>
            <p class="text-stone-300 text-sm md:text-base leading-relaxed font-semibold">
              Bei uns ist Ihr Auto keine Nummer. Wir verbinden traditionelles Schweizer KFZ-Handwerk mit modernster elektronischer Diagnostik. Ob MFK-Vorführung, Fahrwerksservice oder An- & Verkauf – wir garantieren transparente Preise und höchste Präzision im Schossacher 22 in Dübendorf.
            </p>
            <div class="grid grid-cols-2 gap-4 pt-2">
              <div class="glass-card-gold p-4 rounded-xl border border-[#D4AF37]/30">
                <span class="text-2xl font-bold text-[#FFD700] font-mono">15+</span>
                <span class="block text-xs text-stone-400 font-bold">Jahre Erfahrung</span>
              </div>
              <div class="glass-card-gold p-4 rounded-xl border border-[#D4AF37]/30">
                <span class="text-2xl font-bold text-[#E6C200] font-mono">500+</span>
                <span class="block text-xs text-stone-400 font-bold">Verkaufte Occasionen</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <WhyUs client:visible />
    <Testimonials client:visible />
  </main>

  <Footer client:visible />
</Layout>
