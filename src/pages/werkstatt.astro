---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
import Services from '../components/Services.jsx';
import ContactSection from '../components/ContactSection.jsx';
import Footer from '../components/Footer.jsx';
import Preloader from '../components/Preloader.jsx';
import { Wrench, ShieldCheck } from 'lucide-react';
---

<Layout title="Werkstatt & MFK Services | Schossacher Garage Schweiz">
  <Preloader client:load />
  <Navbar client:load />
  
  <main class="pt-28 pb-16">
    {/* Page Header */}
    <section class="py-16 relative bg-[#FEF9E7] border-b border-[#D4AF37]/20">
      <div class="container text-center max-w-3xl space-y-4">
        <div class="gold-badge mx-auto">
          <Wrench className="w-4 h-4 text-[#785E07]" />
          <span>Schweizer Meisterbetrieb</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold text-stone-900 tracking-tight font-serif">
          Werkstatt & <span class="text-gold-gradient">MFK Services</span>
        </h1>
        <p class="text-stone-700 text-base md:text-lg font-semibold">
          Qualitätsgeprüfte Reparaturen, Wartungen nach Herstellervorgaben und 100% MFK-Vorführgarantie für alle Marken.
        </p>
      </div>
    </section>

    <Services client:visible />

    {/* Service Guarantee Highlight Banner */}
    <section class="py-16 bg-[#FFFDF5] relative">
      <div class="container">
        <div class="glass-card-gold p-8 md:p-12 border-[#D4AF37]/30 text-center space-y-6 max-w-4xl mx-auto">
          <div class="w-14 h-14 rounded-2xl bg-[#FEF08A] border border-[#D4AF37] flex items-center justify-center text-[#785E07] mx-auto">
            <ShieldCheck className="w-8 h-8" />
          </div>
          <h2 class="text-3xl font-bold text-stone-900 font-serif">Unsere Schweizer Service-Garantie</h2>
          <p class="text-stone-700 text-sm md:text-base max-w-2xl mx-auto font-semibold">
            Jede Arbeit in der Schossacher Garage beinhaltet 12 Monate Garantie auf Ersatzteile & Arbeit. Wir arbeiten streng nach Werksvorgaben – damit bleibt Ihre Neuwagen-Herstellergarantie vollständig erhalten.
          </p>
          <div class="pt-4 flex justify-center gap-4">
            <a href="/kontakt" class="btn-gold text-sm">
              Termin Buchen
            </a>
          </div>
        </div>
      </div>
    </section>

    <ContactSection client:visible />
  </main>

  <Footer client:visible />
</Layout>
